# ============================================================
# .gitignore raíz — repositorio `typescript`
# Regla de oro: los artefactos generados (deps, builds, cachés)
# nunca se versionan; los `.js` compilados SÍ se versionan solo en
# typescript01/chapter01, 02, 04, 06 y 06a, porque sus index.html
# los cargan directamente.
# ============================================================

# ---------- Dependencias ----------
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
pnpm-store/
.pnpm-store/

# ---------- Salidas de build ----------
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# ---------- Cachés de bundlers y linters ----------
.vite/
.cache/
.parcel-cache/
.eslintcache
.turbo/
.vercel/
.snowpack/
.webpack/

# ---------- Empaquetado ----------
*.tgz
*.tar.gz

# ---------- Variables de entorno ----------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local
!.env.example

# ---------- Logs ----------
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---------- Testing ----------
coverage/
.nyc_output/
playwright-report/
test-results/

# ---------- Restos de Git ----------
*.orig
*.rej
*.BACKUP.*
*.BASE.*
*.LOCAL.*
*.REMOTE.*

# ---------- Herramientas locales ----------
.opencode/
.docusaurus/

# ---------- IDEs y editores ----------
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-workspace
*.sublime-project
*.swp
*.swo

# ---------- Sistema operativo ----------
.DS_Store
Thumbs.db
desktop.ini
